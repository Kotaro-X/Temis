rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(["admin"])
        && request.auth.token.admin == true;
    }

    function isGoogleUser() {
      return signedIn()
        && request.auth.token.keys().hasAny(["firebase"])
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function subscriptionAccessPath(userId) {
      return /databases/$(database)/documents/subscriptionAccess/$(userId);
    }

    function inviteCodePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    function inviteRedemptionPath(code, userId) {
      return /databases/$(database)/documents/inviteCodes/$(code)/redemptions/$(userId);
    }

    function isInviteGrantType(value) {
      return value == "invite_free" || value == "invite_discount";
    }

    function grantKeysAreValid() {
      return request.resource.data.keys().hasOnly([
        "userId",
        "active",
        "grantType",
        "inviteCode",
        "offeringId",
        "packageId",
        "expiresAt",
        "grantedBy",
        "note",
        "redeemedAt",
        "updatedAt",
      ]);
    }

    function inviteCodeFieldsAreValid() {
      return request.resource.data.keys().hasOnly([
        "code",
        "active",
        "grantType",
        "offeringId",
        "packageId",
        "expiresAt",
        "maxRedemptions",
        "redeemedCount",
        "createdBy",
        "note",
        "updatedAt",
      ]);
    }

    function inviteRedemptionFieldsAreValid() {
      return request.resource.data.keys().hasOnly([
        "userId",
        "inviteCode",
        "grantType",
        "email",
        "name",
        "redeemedAt",
      ]);
    }

    function validInviteCodeForSelfRedemption(code) {
      let invite = get(inviteCodePath(code));
      return invite.data.active == true
        && isInviteGrantType(invite.data.grantType)
        && (invite.data.expiresAt == null || invite.data.expiresAt > request.time.toMillis())
        && (
          invite.data.maxRedemptions == null ||
          invite.data.redeemedCount < invite.data.maxRedemptions ||
          exists(inviteRedemptionPath(code, request.auth.uid))
        );
    }

    function validSelfInviteGrantWrite(userId) {
      let code = request.resource.data.inviteCode;
      let invite = get(inviteCodePath(code));
      let priorGrant = exists(subscriptionAccessPath(userId))
        ? get(subscriptionAccessPath(userId)).data
        : null;
      return isSelf(userId)
        && isGoogleUser()
        && grantKeysAreValid()
        && request.resource.data.userId == userId
        && request.resource.data.active == true
        && isInviteGrantType(request.resource.data.grantType)
        && validInviteCodeForSelfRedemption(code)
        && request.resource.data.grantType == invite.data.grantType
        && request.resource.data.offeringId == invite.data.offeringId
        && request.resource.data.packageId == invite.data.packageId
        && request.resource.data.expiresAt == invite.data.expiresAt
        && request.resource.data.note == invite.data.note
        && request.resource.data.grantedBy == invite.data.createdBy
        && request.resource.data.redeemedAt is int
        && request.resource.data.updatedAt is int
        && !(priorGrant != null && priorGrant.grantType == "staff_free" && priorGrant.active == true)
        && (
          priorGrant == null ||
          priorGrant.inviteCode == null ||
          priorGrant.inviteCode == code ||
          priorGrant.active != true
        );
    }

    function validSelfInviteCodeCounterUpdate(code) {
      let updatedInvite = request.resource.data;
      let accessAfter = getAfter(subscriptionAccessPath(request.auth.uid)).data;
      let redemptionBeforeExists = exists(inviteRedemptionPath(code, request.auth.uid));
      let redemptionAfter = getAfter(inviteRedemptionPath(code, request.auth.uid)).data;
      return signedIn()
        && !isAdmin()
        && isGoogleUser()
        && resource.data.active == true
        && isInviteGrantType(resource.data.grantType)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "redeemedCount",
          "updatedAt",
        ])
        && updatedInvite.redeemedCount == resource.data.redeemedCount + 1
        && updatedInvite.updatedAt is int
        && !redemptionBeforeExists
        && accessAfter.userId == request.auth.uid
        && accessAfter.inviteCode == code
        && accessAfter.grantType == resource.data.grantType
        && redemptionAfter.userId == request.auth.uid
        && redemptionAfter.inviteCode == code
        && redemptionAfter.grantType == resource.data.grantType;
    }

    function validSelfInviteRedemptionCreate(code, userId) {
      let invite = get(inviteCodePath(code));
      let accessAfter = getAfter(subscriptionAccessPath(userId)).data;
      let inviteAfter = getAfter(inviteCodePath(code)).data;
      return isSelf(userId)
        && isGoogleUser()
        && inviteRedemptionFieldsAreValid()
        && validInviteCodeForSelfRedemption(code)
        && request.resource.data.userId == userId
        && request.resource.data.inviteCode == code
        && request.resource.data.grantType == invite.data.grantType
        && request.resource.data.redeemedAt is int
        && accessAfter.userId == userId
        && accessAfter.inviteCode == code
        && accessAfter.grantType == invite.data.grantType
        && inviteAfter.redeemedCount == invite.data.redeemedCount + 1;
    }

    // User-owned sync data is an explicit allowlist. Do not add a recursive
    // match below /users: an unmatched path is denied, including to admins.
    function validString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validNullableString(value, maxLength) {
      return value == null || validString(value, maxLength);
    }

    function validNullableInt(value) {
      return value == null || value is int;
    }

    function validStringList(value, maxItems) {
      // Rules cannot express a generic "every list member is a string" check.
      // We still constrain the container and each nested schema that uses it.
      return value is list && value.size() <= maxItems;
    }

    function validTagDocument(data, tagId) {
      return data.keys().hasAll([
          "id", "name", "order", "createdAt", "updatedAt", "archivedAt",
          "isDeleted", "deletedAt", "deviceId",
        ])
        && data.keys().hasOnly([
          "id", "name", "order", "createdAt", "updatedAt", "archivedAt",
          "isDeleted", "deletedAt", "deviceId",
        ])
        && data.id == tagId
        && validString(data.id, 128)
        && validString(data.name, 200)
        && data.order is number
        && data.createdAt is int
        && data.updatedAt is int
        && validNullableInt(data.archivedAt)
        && data.isDeleted is bool
        && data.isDeleted == (data.deletedAt != null)
        && validNullableInt(data.deletedAt)
        && validNullableString(data.deviceId, 128);
    }

    function validTodoRecord(data, entityId) {
      return data.keys().hasAll([
          "id", "text", "memo", "tags", "isDone", "createdAt", "doneAt",
          "reminderDate", "reminderTime", "repeat", "notificationId",
          "notificationIds", "seriesId", "seriesAnchorDate", "occurrenceDate",
          "isDeleted",
        ])
        && data.keys().hasOnly([
          "id", "text", "memo", "tags", "isDone", "createdAt", "doneAt",
          "reminderDate", "reminderTime", "repeat", "notificationId",
          "notificationIds", "seriesId", "seriesAnchorDate", "occurrenceDate",
          "isDeleted",
        ])
        && data.id == entityId
        && validString(data.id, 512)
        && validString(data.text, 10000)
        && validString(data.memo, 50000)
        && validStringList(data.tags, 100)
        && data.isDone is bool
        && data.createdAt is int
        && validNullableInt(data.doneAt)
        && validNullableString(data.reminderDate, 32)
        && validNullableString(data.reminderTime, 16)
        && data.repeat in ["none", "daily", "weekly", "monthly", "yearly"]
        && validNullableString(data.notificationId, 256)
        && validStringList(data.notificationIds, 100)
        && validNullableString(data.seriesId, 512)
        && validNullableString(data.seriesAnchorDate, 32)
        && validNullableString(data.occurrenceDate, 32)
        && data.isDeleted is bool;
    }

    function validTaskState(data) {
      return data.keys().hasAll([
          "id", "taskName", "tags", "estimateMinutes", "elapsedMinutes",
          "status", "isArchived", "startAt",
        ])
        && data.keys().hasOnly([
          "id", "taskName", "tags", "estimateMinutes", "elapsedMinutes",
          "status", "isArchived", "startAt",
        ])
        && validString(data.id, 512)
        && validString(data.taskName, 1000)
        && validStringList(data.tags, 100)
        && data.estimateMinutes is number
        && data.elapsedMinutes is number
        && data.status in ["TODO", "IN_PROGRESS", "PAUSED", "DONE"]
        && data.isArchived is bool
        && validNullableInt(data.startAt);
    }

    function validTaskLog(data) {
      return data.keys().hasAll([
          "id", "date", "slot", "taskId", "taskName", "tags",
          "estimateMinutes", "actualMinutes", "result", "endedAt",
        ])
        && data.keys().hasOnly([
          "id", "date", "slot", "taskId", "taskName", "tags",
          "estimateMinutes", "actualMinutes", "result", "endedAt",
        ])
        && validString(data.id, 512)
        && validString(data.date, 32)
        && data.slot in ["morning", "forenoon", "afternoon", "night"]
        && validString(data.taskId, 512)
        && validString(data.taskName, 1000)
        && validStringList(data.tags, 100)
        && data.estimateMinutes is number
        && data.actualMinutes is number
        && data.result in ["completed", "failed"]
        && data.endedAt is int;
    }

    function validTaskRecord(data) {
      return (
        data.kind == "state"
        && data.keys().hasAll(["kind", "date", "slotKey", "task"])
        && data.keys().hasOnly(["kind", "date", "slotKey", "task"])
        && validString(data.date, 32)
        && data.slotKey in ["morning", "forenoon", "afternoon", "night"]
        && data.task is map
        && validTaskState(data.task)
      ) || (
        data.kind == "log"
        && data.keys().hasAll(["kind", "log"])
        && data.keys().hasOnly(["kind", "log"])
        && data.log is map
        && validTaskLog(data.log)
      );
    }

    function validTaskMemo(data, entityId) {
      return data.keys().hasAll(["id", "taskId", "body", "createdAt", "updatedAt"])
        && data.keys().hasOnly(["id", "taskId", "body", "createdAt", "updatedAt"])
        && data.id == entityId
        && validString(data.id, 512)
        && validString(data.taskId, 512)
        && validString(data.body, 200000)
        && data.createdAt is int
        && data.updatedAt is int;
    }

    function validNote(data, entityId) {
      return data.keys().hasAll(["id", "type", "date", "title", "body", "updatedAt"])
        && data.keys().hasOnly(["id", "type", "date", "title", "body", "scope", "projectId", "updatedAt"])
        && data.id == entityId
        && validString(data.id, 512)
        && data.type in ["daily", "free"]
        && validNullableString(data.date, 32)
        && validNullableString(data.title, 1000)
        && validString(data.body, 200000)
        // The scope pair is optional only while older released apps still
        // write the previous note envelope. Missing fields mean personal.
        && (!data.keys().hasAny(["scope", "projectId"]) || (
          data.keys().hasAll(["scope", "projectId"])
          && data.scope in ["personal", "project"]
          && validNullableString(data.projectId, 128)
          && ((data.scope == "personal" && data.projectId == null) || (data.scope == "project" && data.projectId != null))
        ))
        && data.updatedAt is int;
    }

    function validResearchNote(data, entityId) {
      return data.keys().hasAll([
          "id", "title", "body", "tags", "createdAt", "updatedAt", "weekId",
          "weeklyPromptId",
        ])
        && data.keys().hasOnly([
          "id", "title", "body", "tags", "createdAt", "updatedAt", "weekId",
          "weeklyPromptId",
        ])
        && data.id == entityId
        && validString(data.id, 512)
        && validString(data.title, 1000)
        && validString(data.body, 200000)
        && validStringList(data.tags, 100)
        && data.createdAt is int
        && data.updatedAt is int
        && validString(data.weekId, 128)
        && validString(data.weeklyPromptId, 512);
    }

    function validMemoRecord(data, entityId) {
      return (
        data.kind == "taskMemo"
        && data.keys().hasAll(["kind", "data"])
        && data.keys().hasOnly(["kind", "data"])
        && data.data is map
        && validTaskMemo(data.data, entityId)
      ) || (
        data.kind == "note"
        && data.keys().hasAll(["kind", "data"])
        && data.keys().hasOnly(["kind", "data"])
        && data.data is map
        && validNote(data.data, entityId)
      ) || (
        data.kind == "research"
        && data.keys().hasAll(["kind", "data"])
        && data.keys().hasOnly(["kind", "data"])
        && data.data is map
        && validResearchNote(data.data, entityId)
      );
    }

    function validSyncEnvelope(data, entityType, documentId) {
      return data.keys().hasAll([
          "schemaVersion", "entityType", "entityId", "record", "updatedAt", "isDeleted", "deletedAt", "deviceId",
        ])
        && data.keys().hasOnly([
          "schemaVersion", "entityType", "entityId", "record", "updatedAt", "isDeleted", "deletedAt", "deviceId",
        ])
        && data.schemaVersion == 3
        && data.entityType == entityType
        && data.entityId == documentId
        && validString(data.entityId, 512)
        && data.record is map
        && data.updatedAt is int
        && data.isDeleted is bool
        && data.isDeleted == (data.deletedAt != null)
        && validNullableInt(data.deletedAt)
        && validNullableString(data.deviceId, 128);
    }

    function validTodoEnvelope(data, documentId) {
      return validSyncEnvelope(data, "todo", documentId)
        && validTodoRecord(data.record, documentId);
    }

    function validTaskEnvelope(data, documentId) {
      return validSyncEnvelope(data, "task", documentId)
        && validTaskRecord(data.record);
    }

    function validMemoEnvelope(data, documentId) {
      return validSyncEnvelope(data, "memo", documentId)
        && validMemoRecord(data.record, documentId);
    }

    match /users/{userId}/tags/{tagId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && validTagDocument(request.resource.data, tagId);
      allow update: if isSelf(userId)
        && validTagDocument(request.resource.data, tagId)
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isSelf(userId);
    }

    match /users/{userId}/todos/{todoId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && validTodoEnvelope(request.resource.data, todoId);
      allow update: if isSelf(userId)
        && validTodoEnvelope(request.resource.data, todoId)
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isSelf(userId);
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && validTaskEnvelope(request.resource.data, taskId);
      allow update: if isSelf(userId)
        && validTaskEnvelope(request.resource.data, taskId)
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isSelf(userId);
    }

    match /users/{userId}/memos/{memoId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && validMemoEnvelope(request.resource.data, memoId);
      allow update: if isSelf(userId)
        && validMemoEnvelope(request.resource.data, memoId)
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if isSelf(userId);
    }

    match /subscriptionAccess/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isAdmin() || validSelfInviteGrantWrite(userId);
      allow delete: if isAdmin();
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validSelfInviteCodeCounterUpdate(code);

      match /redemptions/{userId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isAdmin() || validSelfInviteRedemptionCreate(code, userId);
        allow update, delete: if isAdmin();
      }
    }

    // Collaboration is deliberately separate from /users/{uid}: personal
    // sync documents stay private unless an owner copies a note to projectNotes.
    function projectPath(projectId) {
      return /databases/$(database)/documents/projects/$(projectId);
    }

    function projectMemberPath(projectId, userId) {
      return /databases/$(database)/documents/projects/$(projectId)/members/$(userId);
    }

    function isProjectMember(projectId) {
      return signedIn() && exists(projectMemberPath(projectId, request.auth.uid));
    }

    function projectRole(projectId) {
      return get(projectMemberPath(projectId, request.auth.uid)).data.role;
    }

    function isProjectEditor(projectId) {
      return isProjectMember(projectId) && projectRole(projectId) in ["owner", "member"];
    }

    function isProjectOwner(projectId) {
      return isProjectMember(projectId) && projectRole(projectId) == "owner";
    }

    function validProfile(data, userId) {
      return data.keys().hasAll([
          "userId", "username", "displayName", "photoUrl", "bio", "interestTags",
          "skillTags", "affiliation", "profileVisibility", "connectionRequestPolicy",
          "createdAt", "updatedAt", "usernameChangedAt",
        ])
        && data.keys().hasOnly([
          "userId", "username", "displayName", "photoUrl", "bio", "interestTags",
          "skillTags", "affiliation", "profileVisibility", "connectionRequestPolicy",
          "createdAt", "updatedAt", "usernameChangedAt",
        ])
        && data.userId == userId
        && validString(data.username, 30)
        && validString(data.displayName, 100)
        && validNullableString(data.photoUrl, 2000)
        && validNullableString(data.bio, 500)
        && validStringList(data.interestTags, 30)
        && validStringList(data.skillTags, 30)
        && validNullableString(data.affiliation, 200)
        && data.profileVisibility in ["public", "connections_only", "private"]
        && data.connectionRequestPolicy in ["everyone", "connections_only", "disabled"]
        && data.createdAt is int && data.updatedAt is int
        && validNullableInt(data.usernameChangedAt);
    }

    function validProject(data, projectId) {
      return data.keys().hasAll([
          "id", "name", "description", "ownerUserId", "icon", "tags", "visibility",
          "joinPolicy", "invitationPolicy", "taskEnabled", "createdAt", "updatedAt", "deletedAt",
        ])
        && data.keys().hasOnly([
          "id", "name", "description", "ownerUserId", "icon", "tags", "visibility",
          "joinPolicy", "invitationPolicy", "taskEnabled", "createdAt", "updatedAt", "deletedAt",
        ])
        && data.id == projectId && validString(data.name, 120)
        && validNullableString(data.description, 4000) && validNullableString(data.icon, 64)
        && validStringList(data.tags, 30)
        && data.visibility in ["private", "invite_only", "public"]
        && data.joinPolicy in ["invitation_only", "approval_required", "open"]
        && data.invitationPolicy in ["owner_only", "members"]
        && data.taskEnabled is bool && data.createdAt is int && data.updatedAt is int
        && validNullableInt(data.deletedAt);
    }

    function validProjectMember(data, userId) {
      return data.keys().hasOnly(["userId", "role", "invitationId", "joinedAt", "updatedAt"])
        && data.userId == userId && data.role in ["owner", "member", "viewer"]
        && validNullableString(data.invitationId, 128)
        && data.joinedAt is int && data.updatedAt is int;
    }

    match /profiles/{userId} {
      allow get: if isSelf(userId) || resource.data.profileVisibility == "public";
      allow list: if signedIn() && resource.data.profileVisibility == "public";
      allow create: if isSelf(userId) && isGoogleUser() && validProfile(request.resource.data, userId)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == userId;
      allow update: if isSelf(userId) && validProfile(request.resource.data, userId)
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.userId == userId;
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(["userId", "username", "reservedUntil", "updatedAt"])
        && request.resource.data.userId == request.auth.uid && request.resource.data.username == username
        && validNullableInt(request.resource.data.reservedUntil) && request.resource.data.updatedAt is int;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(["userId", "username", "reservedUntil", "updatedAt"])
        && request.resource.data.username == username && request.resource.data.updatedAt is int
        && (resource.data.userId == request.auth.uid || (resource.data.reservedUntil != null && resource.data.reservedUntil <= request.time.toMillis()))
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["id", "userIds", "requesterUserId", "recipientUserId", "status", "blockedByUserId", "createdAt", "updatedAt"])
        && request.resource.data.id == connectionId && request.resource.data.requesterUserId == request.auth.uid
        && (request.resource.data.status == "pending" || (request.resource.data.status == "blocked" && request.resource.data.blockedByUserId == request.auth.uid)) && request.auth.uid in request.resource.data.userIds
        && request.resource.data.recipientUserId in request.resource.data.userIds;
      allow update: if signedIn() && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && ((resource.data.status == "pending" && resource.data.recipientUserId == request.auth.uid && request.resource.data.status == "connected")
          || request.resource.data.status == "blocked");
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    match /projects/{projectId} {
      allow get: if isProjectMember(projectId) || resource.data.visibility == "public";
      allow list: if resource.data.visibility == "public";
      allow create: if signedIn() && validProject(request.resource.data, projectId)
        && request.resource.data.ownerUserId == request.auth.uid
        && getAfter(projectMemberPath(projectId, request.auth.uid)).data.role == "owner";
      allow update: if isProjectOwner(projectId) && validProject(request.resource.data, projectId)
        && request.resource.data.ownerUserId == resource.data.ownerUserId;
      allow delete: if false;

      match /members/{userId} {
        // A collection-group query for a user's project list can only prove
        // access to that user's own membership document. Project member lists
        // remain available to existing members through the second condition.
        allow get: if isProjectMember(projectId);
        allow list: if (signedIn() && resource.data.userId == request.auth.uid)
          || isProjectMember(projectId);
        allow create: if ((request.resource.data.role == "owner" && request.resource.data.invitationId == null
            && getAfter(projectPath(projectId)).data.ownerUserId == userId) || isProjectOwner(projectId) || (
            signedIn() && userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/projectInvitations/$(request.resource.data.invitationId)).data.inviteeUserId == request.auth.uid
          )) && validProjectMember(request.resource.data, userId);
        allow update: if isProjectOwner(projectId) && validProjectMember(request.resource.data, userId);
        allow delete: if isProjectOwner(projectId) && resource.data.role != "owner";
      }
    }

    // A top-level, self-readable membership index avoids a collection-group
    // query and its extra index requirement when opening the project tab.
    match /projectMemberships/{membershipId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["id", "projectId", "userId", "role", "updatedAt"])
        && request.resource.data.id == membershipId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role in ["owner", "member", "viewer"]
        && request.resource.data.updatedAt is int
        && getAfter(projectMemberPath(request.resource.data.projectId, request.auth.uid)).data.role == request.resource.data.role;
      allow update, delete: if false;
    }

    match /projectInvitations/{invitationId} {
      allow read: if signedIn() && (resource.data.inviterUserId == request.auth.uid || resource.data.inviteeUserId == request.auth.uid);
      allow create: if isProjectMember(request.resource.data.projectId)
        && (projectRole(request.resource.data.projectId) == "owner" || get(projectPath(request.resource.data.projectId)).data.invitationPolicy == "members")
        && request.resource.data.inviterUserId == request.auth.uid && request.resource.data.status == "pending";
      allow update: if signedIn() && resource.data.inviteeUserId == request.auth.uid
        && resource.data.status == "pending" && request.resource.data.status in ["accepted", "declined"];
      allow delete: if signedIn() && resource.data.inviterUserId == request.auth.uid;
    }

    match /projectNotes/{noteId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if signedIn() && request.resource.data.id == noteId
        && request.resource.data.ownerUserId == request.auth.uid
        && isProjectEditor(request.resource.data.projectId);
      allow update: if signedIn() && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    match /projectTasks/{taskId} {
      allow read: if isProjectMember(resource.data.projectId);
      allow create: if signedIn() && request.resource.data.id == taskId
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.creatorUserId == request.auth.uid
        && isProjectEditor(request.resource.data.projectId)
        && get(projectPath(request.resource.data.projectId)).data.taskEnabled == true
        && (request.resource.data.assigneeUserId == null || exists(projectMemberPath(request.resource.data.projectId, request.resource.data.assigneeUserId)));
      allow update: if signedIn() && isProjectMember(resource.data.projectId)
        && (projectRole(resource.data.projectId) in ["owner", "member"] || resource.data.ownerUserId == request.auth.uid || resource.data.creatorUserId == request.auth.uid || resource.data.assigneeUserId == request.auth.uid)
        && (request.resource.data.assigneeUserId == null || exists(projectMemberPath(resource.data.projectId, request.resource.data.assigneeUserId)));
      allow delete: if signedIn() && (isProjectOwner(resource.data.projectId) || resource.data.ownerUserId == request.auth.uid);
    }
  }
}
